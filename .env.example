# Copy to .env and fill in real values. Do not commit .env.

# Telegram bot used to send dictated messages
MPD_TELEGRAM_BOT_TOKEN=

# Default destination chat for dictated Telegram messages
MPD_TELEGRAM_CHAT_ID=

# Optional named destinations used by action {"destination": "BORIS"}
# MPD_TELEGRAM_CHAT_ID_BORIS=

# OpenClaw: gateway auth token is configured by OpenClaw (e.g. gateway.auth.token
# or OPENCLAW_GATEWAY_TOKEN on the gateway host), not in this file.
